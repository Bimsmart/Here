{
  "expo": {
    "name": "Here",
    "slug": "here-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Here to use your location to estimate travel time to your destination."
        }
      ],
      "expo-status-bar",
      "expo-image"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.here.safety"
    }
  }
}
